# HTTP port used by the API server.
PORT=3010

# PostgreSQL connection URL used by the API and migration command.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hireeasy?sslmode=disable

# Secret appended to passwords before hashing; keep this private and stable.
PASSWORD_PEPPER=change-me

# Resend API credential used to send verification emails.
RESEND_API_KEY=re_example

# Verified sender address used in verification emails.
EMAIL_FROM=HireEasy <no-reply@example.com>

# Frontend page that receives the verification token link.
VERIFY_EMAIL_URL=http://localhost:3000/verify-email

# Lifetime, in hours, for an authenticated browser session.
SESSION_DURATION_HOURS=168

# Set true when cookies are served over HTTPS.
COOKIE_SECURE=false
